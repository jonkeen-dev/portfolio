# Local default is an on-disk Postgres build (pglite). Production is Neon:
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=pglite:./.data/pglite

# At least 16 characters. Use a long random value in production.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public origin. Production is https://tracker.jonkeen.dev (no trailing slash).
# Local passkeys need this host to match WEBAUTHN_RP_ID (use http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Calisthenics Tracker

# dev writes .data/mailbox.json. resend sends through Resend.
EMAIL_TRANSPORT=dev
EMAIL_FROM=Calisthenics Tracker <auth@jonkeen.dev>
# EMAIL_REPLY_TO=
# RESEND_API_KEY=

# Comma-separated. Never commit real addresses. The first entry is the owner
# unless OWNER_EMAIL is set. Everyone else needs an invite.
ALLOWED_EMAILS=
OWNER_EMAIL=
MAX_USERS=2

# Leave unset in production. Tests set ALLOW_DEV_MAILBOX=1 with EMAIL_TRANSPORT=dev.
# ALLOW_DEV_MAILBOX=
# RATE_LIMIT_DISABLED=
